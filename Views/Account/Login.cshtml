@model DziennikOcen.Models.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Logowanie - System Oceniania</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
            body {
                background-color: #f8f9fa;
            }
            .login-container {
                max-width: 450px;
                margin-top: 10%;
            }
    </style>
</head>
<body>

    <div class="container d-flex justify-content-center">
        <div class="card shadow login-container p-4 w-100">
            <div class="text-center mb-4">
                <h3 class="text-primary fw-bold">Dziennik Akademicki</h3>
                <p class="text-muted">Zaloguj się do swojego konta</p>
            </div>

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Adres e-mail</label>
                    <input asp-for="Email" class="form-control" placeholder="np. admin@dziennik.pl" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Hasło</label>
                    <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label">Zapamiętaj mnie</label>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">Zaloguj się</button>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>