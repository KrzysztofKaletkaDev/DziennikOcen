@model DziennikOcen.Models.GradeScale

@{
    ViewData["Title"] = "Dodaj do Skali";
}

<div class="container mt-4" style="max-width: 500px;">
    <div class="card shadow-sm p-4">
        <h4 class="mb-3 text-primary">Nowa Ocena Akademicka</h4>
        <hr />

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Value" class="form-label">Wartość dopuszczalna (np. 4.5)</label>
                <input asp-for="Value" class="form-control" type="number" step="0.5" min="1" max="6" placeholder="4.5" />
                <div class="form-text text-muted">Wartość liczbowa brana pod uwagę przy wyliczaniu średniej ocen.</div>
                <span asp-validation-for="Value" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-secondary">Powrót</a>
                <button type="submit" class="btn btn-success">Zapisz w skali</button>
            </div>
        </form>
    </div>
</div>