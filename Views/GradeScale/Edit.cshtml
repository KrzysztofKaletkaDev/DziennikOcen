@model DziennikOcen.Models.GradeScale

@{
    ViewData["Title"] = "Edytuj Skalę";
}

<div class="container mt-4" style="max-width: 500px;">
    <div class="card shadow-sm p-4">
        <h4 class="mb-3 text-warning">Modyfikacja Wartości w Skali</h4>
        <hr />

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Value" class="form-label">Wartość oceny</label>
                <input asp-for="Value" class="form-control" type="number" step="0.5" min="1" max="6" />
                <span asp-validation-for="Value" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
                <button type="submit" class="btn btn-primary">Zapisz zmiany</button>
            </div>
        </form>
    </div>
</div>