@model DziennikOcen.Models.GradeClassification

@{
    ViewData["Title"] = "Dodaj Kategorię";
}

<div class="container mt-4" style="max-width: 550px;">
    <div class="card shadow-sm p-4">
        <h4 class="mb-3 text-primary">Nowy Typ Klasyfikacji Oceny</h4>
        <hr />

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Nazwa kategorii oceny cząstkowej</label>
                <input asp-for="Name" class="form-control" placeholder="np. Kolokwium, Projekt, Egzamin" />
                <div class="form-text text-muted">Określa strukturę i pochodzenie wystawianych ocen studentom.</div>
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-secondary">Powrót</a>
                <button type="submit" class="btn btn-success">Zapisz kategorię</button>
            </div>
        </form>
    </div>
</div>