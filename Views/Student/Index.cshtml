@model IEnumerable<DziennikOcen.Models.Student>

@{
    ViewData["Title"] = "Zarządzanie Studentami";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people"></i> Lista Studentów</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus"></i> Dodaj Studenta</a>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 15%">Numer Indeksu</th>
                        <th style="width: 30%">Nazwisko</th>
                        <th style="width: 30%">Imię</th>
                        <th style="width: 25%" class="text-end">Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">Brak zarejestrowanych studentów.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-secondary text-wrap py-2 px-3 fs-6">@item.StudentNumber</span></td>
                            <td class="fw-bold text-secondary">@item.LastName</td>
                            <td>@item.FirstName</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-2">Edytuj</a>

                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Czy na pewno chcesz usunąć tego studenta? UWAGA: Spowoduje to bezpowrotne usunięcie wszystkich jego ocen!');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Usuń</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>