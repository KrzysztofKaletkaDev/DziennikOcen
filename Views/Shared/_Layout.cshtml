<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DziennikOcen</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DziennikOcen.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">DziennikOcen</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Strona Główna</a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Panel Administratora
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                <li><a class="dropdown-item" asp-controller="Course" asp-action="Index">Zarządzanie Przedmiotami</a></li>
                                <li><a class="dropdown-item" asp-controller="Student" asp-action="Index">Zarządzanie Studentami</a></li>
                                <li><a class="dropdown-item" asp-controller="User" asp-action="Index">Zarządzanie Użytkownikami</a></li>
                                <li><a class="dropdown-item" asp-controller="Role" asp-action="Index">Słownik Ról Systemowych</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="GradeScale" asp-action="Index">Skala Ocen</a></li>
                                <li><a class="dropdown-item" asp-controller="GradeClassification" asp-action="Index">Klasyfikacja Ocen</a></li>
                                </ul>
                            </li>
                        }
    
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item ms-auto">
                                <span class="navbar-text text-dark me-3">
                                    Zalogowany jako: <strong>@User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value</strong>
                                </span>
                                <a class="btn btn-outline-danger btn-sm" asp-controller="Account" asp-action="Logout">Wyloguj się</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - DziennikOcen - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
