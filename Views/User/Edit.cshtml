@model DziennikOcen.Models.UserEditViewModel

@{
    ViewData["Title"] = "Edytuj Użytkownika";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm p-4">
        <h4 class="mb-3 text-warning"><i class="bi bi-pencil-square"></i> Modyfikacja Profilu Użytkownika</h4>
        <hr />

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="IsActive" />

            <div class="mb-3">
                <label asp-for="FirstName" class="form-label">Imię</label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LastName" class="form-label">Nazwisko</label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Adres e-mail (Login)</label>
                <input asp-for="Email" class="form-control" type="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="RoleId" class="form-label">Rola systemowa (Uprawnienia)</label>
                <select asp-for="RoleId" class="form-select" asp-items="ViewBag.Roles"></select>
                <span asp-validation-for="RoleId" class="text-danger small"></span>
            </div>

            <div class="mb-3 p-3 bg-light rounded border">
                <label asp-for="NewPassword" class="form-label fw-bold text-secondary">Wymuś zmianę hasła</label>
                <input asp-for="NewPassword" class="form-control" placeholder="Wpisz nowe hasło zabezpieczające" />
                <div class="form-text text-muted">Pozostaw to pole **puste**, jeśli hasło użytkownika ma pozostać niezmienione.</div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
                <button type="submit" class="btn btn-primary">Zapisz zmiany</button>
            </div>
        </form>
    </div>
</div>