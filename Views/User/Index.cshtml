@model IEnumerable<DziennikOcen.Models.User>

@{
    ViewData["Title"] = "Zarządzanie Użytkownikami";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people-fill"></i> Zarządzanie Użytkownikami Systemu</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus-fill"></i> Dodaj Nowego Użytkownika</a>
    </div>
    @if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-octagon-fill"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 30%">Nazwisko i Imię</th>
                        <th style="width: 25%">Adres E-mail (Login)</th>
                        <th style="width: 15%">Rola systemowa</th>
                        <th style="width: 10%">Status</th>
                        <th style="width: 20%" class="text-end">Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Brak zarejestrowanych użytkowników w systemie.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr class="@(item.IsActive ? "" : "table-light text-muted")">
                            <td class="fw-bold">@item.LastName @item.FirstName</td>
                            <td>@item.Email</td>
                            <td>
                                @if (item.Role?.Name == "Admin")
                                {
                                    <span class="badge bg-primary px-2 py-1"><i class="bi bi-shield-lock"></i> Administrator</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark px-2 py-1"><i class="bi bi-journal-text"></i> Prowadzący</span>
                                }
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Aktywny</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Archiwum</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (item.IsActive)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-2">Edytuj</a>

                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Czy na pewno chcesz zdeaktywować tego użytkownika? Jego historyczne dane i oceny pozostaną w systemie.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Deaktywuj</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Restore" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success">Przywróć konto</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>